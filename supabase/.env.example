# SERVER ONLY. Copy to an ignored environment file for local Edge development.
# Hosted Supabase provides these two automatically. Never compile the service
# role into Flutter, put real values in Git, or paste credentials into chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# JSON for an authorized FCM HTTP v1 service account; keep its private key only
# in server secret storage. See docs/MARKETPLACE_SETUP.md.
FCM_SERVICE_ACCOUNT_JSON=

# Separate cryptographically random scheduler secret, at least 32 characters.
PUSH_DISPATCH_SECRET=
